#!/usr/bin/env bash
# Keeps a copy of this Hyprland session's log in ~/.local/state/yggdrasil/hyprland-logs/, so a crash leaves its log behind.
# Hyprland writes the log into its instance folder under $XDG_RUNTIME_DIR/hypr/ and deletes a finished instance's folder when the
# next one starts, so after a crash (start-hyprland restarts it in safe mode) the crashed session's log is gone (2026-11-03).
# Run at the session's start; it follows the log until that Hyprland exits. The newest five copies are kept, older ones compressed.
set -u
sig=${HYPRLAND_INSTANCE_SIGNATURE:-}
[[ $sig =~ ^[A-Za-z0-9_]+$ ]] || { echo "yggdrasil-hypr-logkeep: no Hyprland instance" >&2; exit 0; }
inst=${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/$sig
dir=${XDG_STATE_HOME:-$HOME/.local/state}/yggdrasil/hyprland-logs
mkdir -p "$dir"

# older copies: compressed, and only the newest five sessions kept
for f in "$dir"/*.log; do [[ -f $f ]] && zstd -q --rm -- "$f" 2>/dev/null; done
find "$dir" -maxdepth 1 -name '*.log.zst' -printf '%T@ %p\n' | sort -rn | tail -n +5 | cut -d' ' -f2- | xargs -r -d '\n' rm -f --

for _ in $(seq 50); do [[ -f $inst/hyprland.log && -s $inst/hyprland.lock ]] && break; sleep 0.1; done
pid=$(head -n1 "$inst/hyprland.lock" 2>/dev/null)
[[ $pid =~ ^[0-9]+$ ]] || { echo "yggdrasil-hypr-logkeep: no Hyprland process in $inst" >&2; exit 0; }
exec tail -n +1 --pid="$pid" -F "$inst/hyprland.log" >"$dir/$(date +%Y-%m-%d-%H%M)-hyprland.log" 2>/dev/null
