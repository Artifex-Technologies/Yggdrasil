#!/usr/bin/env bash
# Loads Yggdrasil's Hyprland plugin (minimize buttons work: see /usr/share/yggdrasil/hyprland/plugin/minimize.cpp).
# Hyprland only loads a plugin built against its own version. It is built as root, by a pacman hook whenever Hyprland or this
# session is installed or updated (yggdrasil-hypr-plugin --build-system, about two seconds), into
# /usr/lib/yggdrasil/hyprland-plugin/<Hyprland's commit>/, and at the session's start it is loaded only from there: Hyprland's
# permission rules (yggdrasil.lua) allow plugins from that root-owned folder and ask about any other, so a program running as
# you cannot slip in a plugin (which could read every key typed) by replacing a file in your own folders.
set -u
src=/usr/share/yggdrasil/hyprland/plugin/minimize.cpp
sysdir=/usr/lib/yggdrasil/hyprland-plugin
log() { printf 'yggdrasil-hypr-plugin: %s\n' "$*" >&2; }

if [[ ${1:-} == --build-system ]]; then
  [[ $EUID -eq 0 ]] || { log "--build-system runs as root (the pacman hook does it)"; exit 1; }
  commit=$(Hyprland --version 2>/dev/null | sed -n 's/.* at commit \([0-9a-f]\{7,64\}\).*/\1/p' | head -1)
  [[ -n $commit ]] || { log "cannot tell the installed Hyprland's commit"; exit 0; }
  flags=$(pkg-config --cflags hyprland pixman-1 libdrm 2>/dev/null) || { log "Hyprland's headers are not installed"; exit 0; }
  install -d -m755 "$sysdir/$commit"
  # shellcheck disable=SC2086
  if ! g++ -shared -fPIC -std=c++26 -O2 $flags "$src" -o "$sysdir/$commit/yggdrasil-minimize.so.tmp" 2>"$sysdir/$commit/build.log"; then
    log "the plugin did not build for Hyprland $commit (see $sysdir/$commit/build.log)"
    rm -f "$sysdir/$commit/yggdrasil-minimize.so.tmp"
    exit 0 # never fail the package transaction over a minimize button
  fi
  chmod 644 "$sysdir/$commit/yggdrasil-minimize.so.tmp"
  mv "$sysdir/$commit/yggdrasil-minimize.so.tmp" "$sysdir/$commit/yggdrasil-minimize.so"
  find "$sysdir" -mindepth 1 -maxdepth 1 -type d ! -name "$commit" -exec rm -rf {} + 2>/dev/null
  log "built for Hyprland $commit"
  exit 0
fi

commit=$(hyprctl -j version 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["commit"])' 2>/dev/null)
[[ $commit =~ ^[0-9a-f]{7,64}$ ]] || { log "Hyprland is not answering"; exit 1; }
hyprctl plugin list 2>/dev/null | grep -q '^Plugin yggdrasil-minimize ' && exit 0
so=$sysdir/$commit/yggdrasil-minimize.so
[[ -s $so ]] || { log "not built for this Hyprland ($commit) yet: sudo yggdrasil-hypr-plugin --build-system"; exit 1; }
out=$(hyprctl plugin load "$so" 2>&1)
[[ $out == ok* ]] || { log "loading failed: $out"; exit 1; }
log "loaded"
