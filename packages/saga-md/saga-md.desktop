[Desktop Entry]
Type=Application
Name=Saga MD
GenericName=Markdown Reader
Comment=Read Markdown and text files formatted, or see and edit their source
Exec=saga-md %f
Icon=saga-md
Terminal=false
Categories=Utility;TextTools;
MimeType=text/markdown;text/x-markdown;text/plain;
Keywords=markdown;md;readme;text;notes;viewer;reader;saga;
StartupWMClass=saga-md
