#!/usr/bin/env python3
"""Build Liki, the icon pack of Yggdrasil (shared by Labyrinth and Chymaera): app logos for the apps installed here.

  liki-build [--shape SHAPE] [--style STYLE] [--name NAME]

  SHAPE  glyph    the bare logo in its colour, no tile (how the Simple Icons page shows them) [default]
         rounded  a square with softly rounded corners (Windows / Material feeling)
         circle   a round tile
         hexagon  a hexagon (Labyrinth's own mark is one)
         squircle the macOS / iOS tile
  STYLE  brand    the brand's colour: a tile in it with a white logo (or, for glyph, the logo in it) [default]
         dark     a dark tile with the logo in the brand's colour
         purple   a dark tile with the logo in Labyrinth purple (the accent colour) for every app

The logos are a selection from Simple Icons (/usr/share/liki/brand-icons, CC0); Minos, Settings,
Calculator and the trash are Labyrinth's own glyphs in the same form. For each installed app (its desktop file's Icon=)
that has a logo here the pack gets an icon of that name. Apps without one fall back to whatever the
panel's other icon sources give. The pack is written to ~/.local/share/icons/<NAME> (default
"Liki"); choose it in KDE's icon settings to use it.
"""
import argparse
import glob
import json
import math
import os
import re
import shutil
import subprocess
import sys

SRC = os.environ.get("LIKI_BRAND_ICONS") or os.environ.get("LABYRINTH_BRAND_ICONS") or "/usr/share/liki/brand-icons"
PURPLE = "7c54d6"


def accent_hex():
    """The desktop's accent color (kdeglobals), as rrggbb; Labyrinth purple if it is not set."""
    base = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    try:
        section = ""
        for line in open(os.path.join(base, "kdeglobals"), encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("["):
                section = line
            elif section == "[General]" and line.startswith("AccentColor="):
                r, g, b = [int(x) for x in line.split("=", 1)[1].split(",")]
                return "%02x%02x%02x" % (r, g, b)
    except (OSError, ValueError):
        pass
    return PURPLE


def conf_path():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "labyrinth", "brand-pack.json")

# desktop icon names (normalised: lower case, letters and digits only) that are not the logo's own name
