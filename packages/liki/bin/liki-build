# File types: a page in a colour of its own (never the accent: only folders follow the accent) with a white glyph, so a PDF,
# a spreadsheet and a script look different at a glance. Glyphs are drawn in a 24-unit box; no text (the icons are rendered
# without fonts). Minos writes the file's extension on the page as well.
G_LINES = '<path d="M5 7h14M5 12h14M5 17h9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" fill="none"/>'
