# Yggdrasil screen locker (Wayland ext-session-lock + PAM): needs a compositor that offers the protocol (Rust): built from packages/lock in this repository.
pkgname=yggdrasil-lock
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil screen locker (Wayland ext-session-lock + PAM): needs a compositor that offers the protocol"
arch=('x86_64')
provides=('labyrinth-lock')
conflicts=('labyrinth-lock')
replaces=('labyrinth-lock')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'wayland' 'fontconfig' 'libxkbcommon' 'pam' 'grim' 'wl-clipboard' 'libnotify' 'xdg-user-dirs')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../lock"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-lock" "$pkgdir/usr/bin/yggdrasil-lock"
  install -Dm755 "$srcdir/target/release/yggdrasil-greeter" "$pkgdir/usr/bin/yggdrasil-greeter"
  # the main display at the login screen: the session hands its choice over through pkexec (no password for whoever is signed
  # in here); the helper writes /var/lib/yggdrasil/greeter/display.conf, readable by all
  install -Dm755 "$srcdir/target/release/yggdrasil-greeter-display" "$pkgdir/usr/lib/yggdrasil/greeter-display"
  install -Dm644 "$_src/data/org.yggdrasil.greeter.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.greeter.policy"
  # the screen between signing in and the desktop (Yggdrasil's session starts it)
  install -Dm755 "$srcdir/target/release/yggdrasil-splash" "$pkgdir/usr/bin/yggdrasil-splash"
  # screenshots of anything on the screen (it captures first, then you choose on the frozen picture)
  install -Dm755 "$srcdir/target/release/yggdrasil-shot" "$pkgdir/usr/bin/yggdrasil-shot"
}
