# Saga MD, the Markdown reader: Markdown and text files shown formatted, or as their source to read and edit (packages/saga-md).
pkgname=saga-md
pkgver=1.0.0
pkgrel=1
pkgdesc="Saga MD, the Markdown reader: Markdown and text files shown formatted, or as their source to read and edit"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig')
optdepends=('xdg-utils: open web links and other files in their own programs'
            'xdg-desktop-portal: the Open dialog (in Yggdrasil it is Minos)')
makedepends=('cargo')
# its first name (2026-11-08, one day): pacman swaps it for this
replaces=('yggdrasil-reader')
conflicts=('yggdrasil-reader')
provides=('yggdrasil-reader')
options=('!lto')

_src="$startdir/../../saga-md"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/saga-md" "$pkgdir/usr/bin/saga-md"
  install -Dm644 "$_src/saga-md.desktop" "$pkgdir/usr/share/applications/saga-md.desktop"
  install -Dm644 "$_src/saga-md.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/saga-md.svg"
}
