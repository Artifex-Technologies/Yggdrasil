# Settings: the everyday settings in one app (GNOME-style), for Yggdrasil.
# Built from packages/settings in this repository (and the shared look in packages/yggdrasil-ui).
pkgname=yggdrasil-settings
pkgver=0.1.0
pkgrel=16
pkgdesc="Settings: Wi-Fi, Bluetooth, displays, sound, appearance, power and more"
arch=('x86_64')
provides=('labyrinth-settings')
conflicts=('labyrinth-settings')
replaces=('labyrinth-settings')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig'
         'networkmanager' 'bluez-utils' 'libpulse' 'power-profiles-daemon' 'pciutils' 'python' 'polkit')
optdepends=('ufw: firewall page'
            'plymouth: the boot screen (Appearance > Boot screen)'
            'python-pillow: your own picture as the boot screen'
            'grub: the graphics card unlock picks its boot entry for one start (Power, Developer options)'
            'nvidia-utils: the Graphics card page (Power, Developer options): readout and fan control')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../settings"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
  python3 -m unittest discover -s helpers/tests
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-settings" "$pkgdir/usr/bin/yggdrasil-settings"
  install -Dm644 "$_src/yggdrasil-settings.desktop" "$pkgdir/usr/share/applications/yggdrasil-settings.desktop"
  # Power > Graphics card in its own window (yggdrasil-settings --gpu-window): named, with an icon, for the dock
  install -Dm644 "$_src/yggdrasil-gpu.desktop" "$pkgdir/usr/share/applications/yggdrasil-gpu.desktop"
  install -Dm644 "$_src/yggdrasil-cpu.desktop" "$pkgdir/usr/share/applications/yggdrasil-cpu.desktop"
  # the administrator helpers Settings runs with pkexec: accounts (Users) and power-mode limits (Power, Developer options)
  install -Dm755 "$_src/helpers/account" "$pkgdir/usr/lib/yggdrasil/account"
  install -Dm755 "$_src/helpers/powerlimit" "$pkgdir/usr/lib/yggdrasil/powerlimit"
  install -Dm644 "$_src/data/org.yggdrasil.account.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.account.policy"
  install -Dm644 "$_src/data/org.yggdrasil.powerlimit.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.powerlimit.policy"
  # the boot screen (Appearance > Boot screen): Plymouth's theme, switched on the first time
  install -Dm755 "$_src/helpers/bootscreen" "$pkgdir/usr/lib/yggdrasil/bootscreen"
  install -Dm644 "$_src/data/org.yggdrasil.bootscreen.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.bootscreen.policy"
  # applies the limits on every power-mode change; the operating system decides whether it is switched on
  install -Dm644 "$_src/data/yggdrasil-powerlimit.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-powerlimit.service"
  # the graphics card unlock (Power, Developer options; offered only on a card in the support table): the helper, its table,
  # its password rule, the boot menu fragment (prints nothing unless an attempt is armed) and the two services that follow an
  # attempt (they start only while one is pending; arming enables them). Plan: Labyrinth OS docs/GPU_UNLOCK.md
  install -Dm755 "$_src/helpers/gpuunlock" "$pkgdir/usr/lib/yggdrasil/gpuunlock"
  install -Dm644 "$_src/data/gpu-unlock-supported.json" "$pkgdir/usr/share/yggdrasil/gpu-unlock/supported.json"
  install -Dm644 "$_src/data/org.yggdrasil.gpuunlock.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.gpuunlock.policy"
  install -Dm755 "$_src/data/41_gpu_unlock" "$pkgdir/etc/grub.d/41_gpu_unlock"
  install -Dm644 "$_src/data/yggdrasil-gpu-unlock-boot.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpu-unlock-boot.service"
  install -Dm644 "$_src/data/yggdrasil-gpu-unlock-verify.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpu-unlock-verify.service"
  # the graphics card's fans (Power > Graphics card): the helper, its password rule, and the root service that keeps them on a
  # chosen speed or curve (started and stopped by the helper; stopping it gives the fans back to the card)
  install -Dm755 "$_src/helpers/gpufan" "$pkgdir/usr/lib/yggdrasil/gpufan"
  install -Dm644 "$_src/data/org.yggdrasil.gpufan.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.gpufan.policy"
  install -Dm644 "$_src/data/yggdrasil-gpufan.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpufan.service"
  # tuning (Power > Processor and Graphics card, Developer options): the processor's multipliers, power limits and turbo, the
  # graphics card's clocks, with the crash guard; its root service applies kept values at start and measures package power
  install -Dm755 "$_src/helpers/tune" "$pkgdir/usr/lib/yggdrasil/tune"
  install -Dm644 "$_src/data/org.yggdrasil.tune.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.tune.policy"
  install -Dm644 "$_src/data/yggdrasil-tune.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-tune.service"
}
