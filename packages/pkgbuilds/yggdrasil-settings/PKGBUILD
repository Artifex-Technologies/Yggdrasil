# Settings: the everyday settings in one app (GNOME-style), for Yggdrasil.
# Built from packages/settings in this repository (and the shared look in packages/yggdrasil-ui), with Settings > Power's
# root helpers tune, casefan, gpufan and powerlimit from packages/power-helpers (Rust; the Python scripts they replaced are
# kept in packages/settings/helpers/python for a rollback), whose loops run in one root service, yggdrasil-power, and the
# on-demand helpers account, bootscreen, game-fix and yggdrasil-gpu-run from packages/settings-helpers (Rust; their Python
# scripts are kept there too).
pkgname=yggdrasil-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="Settings: Wi-Fi, Bluetooth, displays, sound, appearance, power and more"
arch=('x86_64')
provides=('labyrinth-settings')
conflicts=('labyrinth-settings')
replaces=('labyrinth-settings')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'yggdrasil-spell' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig'
         'networkmanager' 'bluez-utils' 'libpulse' 'power-profiles-daemon' 'pciutils' 'python' 'polkit')
optdepends=('ufw: firewall page'
            'hwdata: Wi-Fi & Network: who made each access point (the IEEE list, read offline; pciutils brings it too)'
            "cuda: the graphics card unlock's correctness check and benchmark (gpuunlock bench)"
            'plymouth: the boot screen (Appearance > Boot screen)'
            'grub: the graphics card unlock picks its boot entry for one start (Power, Developer options)'
            'nvidia-utils: the Graphics card page (Power, Developer options): readout and fan control'
            'vulkan-tools: Games: the exact name of each card, so Proton draws on the chosen card'
            'lsfg-vk: Games: frame generation (Lossless Scaling), from Agora')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../settings"
_power="$startdir/../../power-helpers"
_helpers="$startdir/../../settings-helpers"
_wifiscan="$startdir/../../wifiscan"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src" "$_power" "$_helpers" "$_wifiscan"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
  cd "$_power"
  cargo build --release --locked --target-dir "$srcdir/target"
  cd "$_helpers"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
  python3 -m unittest discover -s helpers/tests
  # the power helpers' tests run on fake hwmon trees, a fake card and stand-in MSRs: no hardware is touched
  cd "$_power"
  cargo test --release --locked --target-dir "$srcdir/target"
  # account against a made-up /etc and stand-in tools, bootscreen's drop-ins in bash and pictures, game-fix on a pretend
  # Steam library, gpu-run on a pretend /sys: nothing on the system is touched
  cd "$_helpers"
  cargo test --release --locked --target-dir "$srcdir/target"
  # Wi-Fi & Network's reader of what networks broadcast (built into Settings): its parsers on random and damaged input
  cd "$_wifiscan"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-settings" "$pkgdir/usr/bin/yggdrasil-settings"
  install -Dm644 "$_src/yggdrasil-settings.desktop" "$pkgdir/usr/share/applications/yggdrasil-settings.desktop"
  # Power > Graphics card in its own window (yggdrasil-settings --gpu-window): named, with an icon, for the dock
  install -Dm644 "$_src/yggdrasil-gpu.desktop" "$pkgdir/usr/share/applications/yggdrasil-gpu.desktop"
  # Games: run a program on a chosen graphics card (a Steam launch option: yggdrasil-gpu-run 2 %command%)
  install -Dm755 "$srcdir/target/release/gpu-run" "$pkgdir/usr/bin/yggdrasil-gpu-run"
  # Games > Game fixes: the per-game fixes and their catalogue
  install -Dm755 "$srcdir/target/release/game-fix" "$pkgdir/usr/lib/yggdrasil/game-fix"
  install -Dm644 "$_src/data/game-fixes.json" "$pkgdir/usr/share/yggdrasil/game-fixes.json"
  install -Dm644 "$_src/yggdrasil-cpu.desktop" "$pkgdir/usr/share/applications/yggdrasil-cpu.desktop"
  # the administrator helpers Settings runs with pkexec: accounts (Users) and power-mode limits (Power, Developer options)
  install -Dm755 "$srcdir/target/release/account" "$pkgdir/usr/lib/yggdrasil/account"
  install -Dm755 "$srcdir/target/release/powerlimit" "$pkgdir/usr/lib/yggdrasil/powerlimit"
  install -Dm644 "$_src/data/org.yggdrasil.account.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.account.policy"
  install -Dm644 "$_src/data/org.yggdrasil.powerlimit.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.powerlimit.policy"
  # the boot screen (Appearance > Boot screen): Plymouth's theme, switched on the first time
  install -Dm755 "$srcdir/target/release/bootscreen" "$pkgdir/usr/lib/yggdrasil/bootscreen"
  # Date & Time > "Set time zone automatically": the helper, its user timer (off until the switch enables it) and the polkit
  # rule that lets a signed-in administrator set the time zone without a password (approved by the owner, 2026-11-13)
  install -Dm755 "$srcdir/target/release/autozone" "$pkgdir/usr/lib/yggdrasil/autozone"
  install -Dm644 "$_src/data/yggdrasil-autozone.service" "$pkgdir/usr/lib/systemd/user/yggdrasil-autozone.service"
  install -Dm644 "$_src/data/yggdrasil-autozone.timer" "$pkgdir/usr/lib/systemd/user/yggdrasil-autozone.timer"
  install -Dm644 "$_src/data/50-yggdrasil-timezone.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-yggdrasil-timezone.rules"
  install -Dm644 "$_src/data/org.yggdrasil.bootscreen.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.bootscreen.policy"
  # applies the limits on every power-mode change (a part of yggdrasil-power); the operating system decides whether it is on
  install -Dm644 "$_src/data/yggdrasil-powerlimit.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-powerlimit.service"
  # the graphics card unlock (Power, Developer options; offered only on a card in the support table): the helper, its table,
  # its password rule, the boot menu fragment (prints nothing unless an attempt is armed) and the two services that follow an
  # attempt (they start only while one is pending; arming enables them). Plan: Labyrinth OS docs/GPU_UNLOCK.md
  install -Dm755 "$_src/helpers/gpuunlock" "$pkgdir/usr/lib/yggdrasil/gpuunlock"
  # its correctness check and tensor benchmark, compiled with nvcc on first use (Phase 2; needs the cuda package)
  install -Dm644 "$_src/helpers/gpuunlock-bench.cu" "$pkgdir/usr/lib/yggdrasil/gpuunlock-bench.cu"
  install -Dm644 "$_src/data/gpu-unlock-supported.json" "$pkgdir/usr/share/yggdrasil/gpu-unlock/supported.json"
  install -Dm644 "$_src/data/org.yggdrasil.gpuunlock.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.gpuunlock.policy"
  install -Dm755 "$_src/data/41_gpu_unlock" "$pkgdir/etc/grub.d/41_gpu_unlock"
  install -Dm644 "$_src/data/yggdrasil-gpu-unlock-boot.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpu-unlock-boot.service"
  install -Dm644 "$_src/data/yggdrasil-gpu-unlock-verify.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpu-unlock-verify.service"
  # the graphics card's fans (Power > Graphics card): the helper, its password rule, and the unit that keeps them on a chosen
  # speed or curve (a part of yggdrasil-power, started and stopped by the helper; stopping it gives the fans back to the card)
  install -Dm755 "$srcdir/target/release/gpufan" "$pkgdir/usr/lib/yggdrasil/gpufan"
  install -Dm644 "$_src/data/org.yggdrasil.gpufan.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.gpufan.policy"
  install -Dm644 "$_src/data/yggdrasil-gpufan.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-gpufan.service"
  install -Dm755 "$srcdir/target/release/casefan" "$pkgdir/usr/lib/yggdrasil/casefan"
  install -Dm644 "$_src/data/yggdrasil-casefan.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-casefan.service"
  install -Dm644 "$_src/data/org.yggdrasil.casefan.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.casefan.policy"
  # tuning (Power > Processor and Graphics card, Developer options): the processor's multipliers, power limits and turbo, the
  # graphics card's clocks, with the crash guard; its unit (a part of yggdrasil-power) applies kept values at start and
  # measures package power
  install -Dm755 "$srcdir/target/release/tune" "$pkgdir/usr/lib/yggdrasil/tune"
  install -Dm644 "$_src/data/org.yggdrasil.tune.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.tune.policy"
  install -Dm644 "$_src/data/yggdrasil-tune.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-tune.service"
  # the one root service that runs the loops of tune, casefan, gpufan and powerlimit (the four units above are its switches),
  # so the NVIDIA library is loaded once; and the hook that moves an upgraded system's running services into it
  install -Dm755 "$srcdir/target/release/power" "$pkgdir/usr/lib/yggdrasil/power"
  install -Dm644 "$_src/data/yggdrasil-power.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-power.service"
  install -Dm644 "$_src/data/90-yggdrasil-power.hook" "$pkgdir/usr/share/libalpm/hooks/90-yggdrasil-power.hook"
}
