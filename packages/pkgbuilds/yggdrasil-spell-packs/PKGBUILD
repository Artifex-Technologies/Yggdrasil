# Word packs for Yggdrasil's spelling (yggdrasil-spell): words the language dictionaries do not have. Built from cspell-dicts
# (https://github.com/streetsidesoftware/cspell-dicts), pinned to one commit; each dictionary used is MIT-licensed (the collection's
# top-level GPL-3.0 does not apply to them; each has its own LICENSE, installed below). cspell's list of common English misspellings
# (CC BY-SA 4.0) is used only while building, to keep known typos out of the packs; it is not installed.
pkgname=yggdrasil-spell-packs
pkgver=2026.11.03
pkgrel=2
_commit=0964f5242efaf11541eaed8a6abffa1c4d8aa277
pkgdesc="Word packs for Yggdrasil's spell checking: software and tech terms, companies and products, gaming, people's names"
arch=('any')
url="https://github.com/streetsidesoftware/cspell-dicts"
license=('MIT')
depends=('yggdrasil-spell')
makedepends=('yggdrasil-spell')
source=(
