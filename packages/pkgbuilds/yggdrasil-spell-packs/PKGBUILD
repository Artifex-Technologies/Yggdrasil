build() {
  cd "$srcdir"
  mkdir -p packs
  yggdrasil-spell build-pack "packs/tech.txt" "Software and tech" "Programming, networking, cloud, security and data science terms" MIT "cspell-dicts ${_commit:0:7} (aws, data-science, docker, filetypes, fonts, fullstack, git, k8s, public-licenses, software-terms)" yes \
    --deny "cspell-en-common-misspellings-dict-en.json" "cspell-software-terms-software-terms.txt" "cspell-software-terms-coding-terms.txt" "cspell-software-terms-coding-compound-terms.txt" "cspell-software-terms-computing-acronyms.txt" "cspell-software-terms-cybersecurity-terms.txt" "cspell-software-terms-network-os.txt" "cspell-software-terms-network-protocols.txt" "cspell-software-terms-software-services.txt" "cspell-software-terms-software-tools.txt" "cspell-fullstack-fullstack.txt" "cspell-fullstack-tools-and-services.txt" "cspell-filetypes-filetypes.txt" "cspell-data-science-data-science-terms.txt" "cspell-data-science-data-science-tools.txt" "cspell-data-science-data-science-models.txt" "cspell-k8s-k8s.txt" "cspell-docker-docker-words.txt" "cspell-git-terms.txt" "cspell-git-additional_words.txt" "cspell-aws-aws.txt" "cspell-fonts-fonts.txt" "cspell-public-licenses-additional-licenses.txt"
  yggdrasil-spell build-pack "packs/companies.txt" "Companies and products" "Company, product, brand and cryptocurrency names" MIT "cspell-dicts ${_commit:0:7} (companies, cryptocurrencies)" yes \
    --deny "cspell-en-common-misspellings-dict-en.json" "cspell-companies-companies.txt" "cspell-cryptocurrencies-cryptocurrencies.txt" "cspell-cryptocurrencies-crypto-terms.txt"
  yggdrasil-spell build-pack "packs/gaming.txt" "Gaming" "Gaming and game development terms" MIT "cspell-dicts ${_commit:0:7} (gaming-terms)" yes \
    --deny "cspell-en-common-misspellings-dict-en.json" "cspell-gaming-terms-gaming-terms.txt" "cspell-gaming-terms-game-development.txt"
  yggdrasil-spell build-pack "packs/names.txt" "People's names" "First names and surnames (off by default: so many names can hide real typos)" MIT "cspell-dicts ${_commit:0:7} (people-names)" no \
    --deny "cspell-en-common-misspellings-dict-en.json" "cspell-people-names-names.txt" "cspell-people-names-us-census.txt"
}

package() {
  cd "$srcdir"
  install -Dm644 -t "$pkgdir/usr/share/yggdrasil/spell/packs" packs/*.txt
  install -Dm644 "cspell-aws-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/aws.LICENSE"
  install -Dm644 "cspell-companies-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/companies.LICENSE"
  install -Dm644 "cspell-cryptocurrencies-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/cryptocurrencies.LICENSE"
  install -Dm644 "cspell-data-science-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/data-science.LICENSE"
  install -Dm644 "cspell-docker-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/docker.LICENSE"
  install -Dm644 "cspell-filetypes-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/filetypes.LICENSE"
  install -Dm644 "cspell-fonts-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/fonts.LICENSE"
  install -Dm644 "cspell-fullstack-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/fullstack.LICENSE"
  install -Dm644 "cspell-gaming-terms-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/gaming-terms.LICENSE"
  install -Dm644 "cspell-git-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/git.LICENSE"
  install -Dm644 "cspell-k8s-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/k8s.LICENSE"
  install -Dm644 "cspell-people-names-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/people-names.LICENSE"
  install -Dm644 "cspell-public-licenses-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/public-licenses.LICENSE"
  install -Dm644 "cspell-software-terms-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/software-terms.LICENSE"
}
