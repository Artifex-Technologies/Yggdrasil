# Yggdrasil's xdg-desktop-portal backend: Minos as the open/save dialog of every application (built from packages/portal).
pkgname=yggdrasil-portal
pkgver=0.1.0
pkgrel=1
pkgdesc="Yggdrasil file-chooser portal backend: Minos as the open and save dialog"
arch=('x86_64')
provides=('labyrinth-portal')
conflicts=('labyrinth-portal')
replaces=('labyrinth-portal')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MIT')
depends=('gcc-libs' 'xdg-desktop-portal' 'yggdrasil-minos')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../portal"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-portal" "$pkgdir/usr/bin/yggdrasil-portal"
}
