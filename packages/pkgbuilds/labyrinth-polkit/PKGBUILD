# Labyrinth polkit authentication agent (the password box for administrator actions): prototype (Rust): built from packages/polkit in this repository.
pkgname=labyrinth-polkit
pkgver=0.1.0
pkgrel=1
pkgdesc="Labyrinth polkit authentication agent (the password box for administrator actions): prototype"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MIT')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig' 'polkit')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../polkit"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-polkit" "$pkgdir/usr/bin/labyrinth-polkit"

}
