# Labyrinth Marketplace: apps in one place (built from packages/market in this repository).
pkgname=labyrinth-market
pkgver=0.1.0
pkgrel=1
pkgdesc="Labyrinth Marketplace: browse and install apps from Labyrinth's catalog and repositories you add"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MIT')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig' 'curl' 'yay' 'ghostty')
optdepends=('flatpak: apps from Flathub')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../market"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-market" "$pkgdir/usr/bin/labyrinth-market"
  install -Dm644 "$_src/labyrinth-market.desktop" "$pkgdir/usr/share/applications/labyrinth-market.desktop"
}
