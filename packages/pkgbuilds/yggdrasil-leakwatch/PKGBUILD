# Maintainer: Yggdrasil
# Builds yggdrasil-leakwatch from packages/leakwatch/ in this repository. Build from
# this directory with `makepkg -s`.
pkgname=yggdrasil-leakwatch
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil's leak watch: warns when a program's memory, or the images it left with the compositor, keeps growing"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'libnotify')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../leakwatch"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --lib --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-leakwatch" "$pkgdir/usr/bin/yggdrasil-leakwatch"
  # a sample every 5 minutes, then the program exits: nothing stays in memory. On for every account.
  install -Dm644 "$_src/systemd/yggdrasil-leakwatch.service" "$pkgdir/usr/lib/systemd/user/yggdrasil-leakwatch.service"
  install -Dm644 "$_src/systemd/yggdrasil-leakwatch.timer" "$pkgdir/usr/lib/systemd/user/yggdrasil-leakwatch.timer"
  install -dm755 "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../yggdrasil-leakwatch.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/yggdrasil-leakwatch.timer"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
