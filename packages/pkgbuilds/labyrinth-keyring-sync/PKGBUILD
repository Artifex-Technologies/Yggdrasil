# Labyrinth keyring sync: one question at login if the keyring and the login password drifted apart (Rust): built from packages/keyring-sync in this repository.
pkgname=labyrinth-keyring-sync
pkgver=0.1.0
pkgrel=1
pkgdesc="Labyrinth keyring sync: one question at login if the keyring and the login password drifted apart"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MIT')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig' 'pam' 'gnome-keyring')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../keyring-sync"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-keyring-sync" "$pkgdir/usr/bin/labyrinth-keyring-sync"
  install -Dm644 "$startdir/../../../profile/airootfs/etc/xdg/autostart/labyrinth-keyring-sync.desktop" "$pkgdir/etc/xdg/autostart/labyrinth-keyring-sync.desktop"
}
