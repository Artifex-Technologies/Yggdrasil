# Yggdrasil's spelling library and the user service that keeps every app's word list in step: packages/spell.
pkgname=yggdrasil-spell
pkgver=1.0.0
pkgrel=1
install=yggdrasil-spell.install
pkgdesc="Yggdrasil spelling: Hunspell dictionaries through a Rust engine, your languages, one word list shared by your apps"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc')  # glibc's iconv converts old dictionaries
optdepends=('hunspell-en_us: US English (other languages: Settings > Keyboard > Spelling and languages)'
            'yggdrasil-spell-packs: word packs (software and tech, companies, gaming, names)'
            'enchant: GTK apps check spelling through it, with your word list'
            'hunspell: enchant'"'"'s Hunspell provider, which reads the same dictionaries')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../spell"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-spell" "$pkgdir/usr/bin/yggdrasil-spell"
  # correcting as you type: an input method, off unless switched on in Settings (which enables this user service)
  install -Dm755 "$srcdir/target/release/yggdrasil-autocorrect" "$pkgdir/usr/bin/yggdrasil-autocorrect"
  install -Dm644 "$_src/yggdrasil-autocorrect.service" "$pkgdir/usr/lib/systemd/user/yggdrasil-autocorrect.service"
  install -Dm644 "$_src/yggdrasil-spell.service" "$pkgdir/usr/lib/systemd/user/yggdrasil-spell.service"
  # on for every user (it only merges word lists; spell checking itself is switched in Settings)
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../yggdrasil-spell.service "$pkgdir/usr/lib/systemd/user/default.target.wants/yggdrasil-spell.service"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/yggdrasil-spell/README.md"
  # the computer's shared word list: the drop folder for the accounts' offers, the root merge it wakes, and the administrators'
  # approve/deny helper (pkexec)
  install -Dm644 "$_src/yggdrasil-spell.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/yggdrasil-spell.conf"
  install -Dm644 "$_src/yggdrasil-spell-global.path" "$pkgdir/usr/lib/systemd/system/yggdrasil-spell-global.path"
  install -Dm644 "$_src/yggdrasil-spell-global.service" "$pkgdir/usr/lib/systemd/system/yggdrasil-spell-global.service"
  install -dm755 "$pkgdir/usr/lib/systemd/system/paths.target.wants"
  ln -s ../yggdrasil-spell-global.path "$pkgdir/usr/lib/systemd/system/paths.target.wants/yggdrasil-spell-global.path"
  install -Dm755 "$_src/spell-global" "$pkgdir/usr/lib/yggdrasil/spell-global"
  install -Dm644 "$_src/org.yggdrasil.spell.policy" "$pkgdir/usr/share/polkit-1/actions/org.yggdrasil.spell.policy"
}
