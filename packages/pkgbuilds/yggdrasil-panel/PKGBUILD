# Yggdrasil's top bar and dock (Rust, Wayland layer-shell, CPU-drawn): packages/panel.
pkgname=yggdrasil-panel
pkgver=0.1.0
pkgrel=4
pkgdesc="Yggdrasil top bar and dock"
arch=('x86_64')
provides=('labyrinth-panel')
conflicts=('labyrinth-panel')
replaces=('labyrinth-panel')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MIT')
depends=('yggdrasil-clipboard' 'gcc-libs' 'wayland' 'fontconfig' 'libkscreen' 'kconfig' 'libxkbcommon' 'wl-clipboard' 'curl' 'pipewire' 'wireplumber' 'libpulse' 'hyprsunset')
makedepends=('cargo')
optdepends=('brightnessctl: the brightness keys (yggdrasil-mediakey)' 'udisks2: opening a drive from its notification (yggdrasil-mount-open)')
options=('!lto')

_src="$startdir/../../panel"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-panel" "$pkgdir/usr/bin/yggdrasil-panel"
  # KWin gives the window list only to programs whose desktop file asks for it, by exact path.
  install -Dm644 "$_src/yggdrasil-panel.desktop" "$pkgdir/usr/share/applications/yggdrasil-panel.desktop"
  # started at login by the desktop session
  install -Dm644 "$_src/yggdrasil-panel-autostart.desktop" "$pkgdir/etc/xdg/autostart/yggdrasil-panel.desktop"
  # small commands for key bindings and the panel: the panel's remote, the multimedia keys, and opening a drive just connected
  install -Dm755 "$_src/bin/yggdrasil-panelctl" "$pkgdir/usr/bin/yggdrasil-panelctl"
  install -Dm755 "$_src/bin/yggdrasil-mediakey" "$pkgdir/usr/bin/yggdrasil-mediakey"
  install -Dm755 "$_src/bin/yggdrasil-mount-open" "$pkgdir/usr/bin/yggdrasil-mount-open"
}
