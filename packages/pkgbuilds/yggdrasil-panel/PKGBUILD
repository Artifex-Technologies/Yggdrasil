# Yggdrasil's top bar and dock (Rust, Wayland layer-shell, CPU-drawn): packages/panel.
pkgname=yggdrasil-panel
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil top bar and dock"
arch=('x86_64')
provides=('labyrinth-panel')
conflicts=('labyrinth-panel')
replaces=('labyrinth-panel')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('yggdrasil-clipboard' 'gcc-libs' 'wayland' 'fontconfig' 'libxkbcommon' 'wl-clipboard' 'curl' 'pipewire' 'wireplumber' 'libpulse' 'hyprsunset')
makedepends=('cargo')
optdepends=('brightnessctl: the brightness keys (yggdrasil-mediakey)' 'udisks2: opening a drive from its notification (yggdrasil-mount-open)')
options=('!lto')

_src="$startdir/../../panel"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-panel" "$pkgdir/usr/bin/yggdrasil-panel"
  # the panel's name and icon for the session
  install -Dm644 "$_src/yggdrasil-panel.desktop" "$pkgdir/usr/share/applications/yggdrasil-panel.desktop"
  # started at login by the desktop session
  install -Dm644 "$_src/yggdrasil-panel-autostart.desktop" "$pkgdir/etc/xdg/autostart/yggdrasil-panel.desktop"
  # and a drop-in for the unit systemd makes of that entry: the panel's end is the unit's end, a crash brings it back
  install -Dm644 "$_src/yggdrasil-panel-autostart.conf" "$pkgdir"'/usr/lib/systemd/user/app-yggdrasil\x2dpanel@autostart.service.d/yggdrasil.conf'
  # small commands for key bindings and the panel (Rust since 2026-11-12, were shell scripts): the panel's remote, the multimedia
  # keys, and opening a drive just connected
  install -Dm755 "$srcdir/target/release/yggdrasil-panelctl" "$pkgdir/usr/bin/yggdrasil-panelctl"
  install -Dm755 "$srcdir/target/release/yggdrasil-mediakey" "$pkgdir/usr/bin/yggdrasil-mediakey"
  install -Dm755 "$srcdir/target/release/yggdrasil-mount-open" "$pkgdir/usr/bin/yggdrasil-mount-open"
}
