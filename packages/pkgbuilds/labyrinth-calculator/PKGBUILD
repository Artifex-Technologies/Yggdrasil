# Labyrinth Calculator: standard with history, scientific when widened (packages/calculator).
pkgname=labyrinth-calculator
pkgver=0.1.0
pkgrel=1
pkgdesc="Labyrinth Calculator: standard with history, scientific when widened"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MIT')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../calculator"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-calculator" "$pkgdir/usr/bin/labyrinth-calculator"
  install -Dm644 "$_src/labyrinth-calculator.desktop" "$pkgdir/usr/share/applications/labyrinth-calculator.desktop"
}
