# Labyrinth screen locker (Wayland ext-session-lock + PAM): needs a compositor that offers the protocol (Rust): built from packages/lock in this repository.
pkgname=labyrinth-lock
pkgver=0.1.0
pkgrel=1
pkgdesc="Labyrinth screen locker (Wayland ext-session-lock + PAM): needs a compositor that offers the protocol"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MIT')
depends=('gcc-libs' 'wayland' 'fontconfig' 'libxkbcommon' 'pam')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../lock"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-lock" "$pkgdir/usr/bin/labyrinth-lock"
  install -Dm755 "$srcdir/target/release/labyrinth-greeter" "$pkgdir/usr/bin/labyrinth-greeter"

}
