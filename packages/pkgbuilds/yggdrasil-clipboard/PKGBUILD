# Yggdrasil's clipboard: history (in memory only) and saved snippets in a window, Super+V: packages/clipboard.
pkgname=yggdrasil-clipboard
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil clipboard history and snippets window"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'wayland' 'libxkbcommon' 'wl-clipboard')
optdepends=('hyprland: Shift+Enter pastes as well as copies')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../clipboard"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-clipboard" "$pkgdir/usr/bin/yggdrasil-clipboard"
  install -Dm644 "$_src/yggdrasil-clipboard.service" "$pkgdir/usr/lib/systemd/user/yggdrasil-clipboard.service"
  # on for every user: the history Super+V shows (it follows Settings' clipboard history switch)
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../yggdrasil-clipboard.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/yggdrasil-clipboard.service"
  install -Dm644 "$_src/yggdrasil-clipboard.desktop" "$pkgdir/usr/share/applications/yggdrasil-clipboard.desktop"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/yggdrasil-clipboard/README.md"
}
