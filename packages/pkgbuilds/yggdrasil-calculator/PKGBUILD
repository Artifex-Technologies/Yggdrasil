# Calculator: standard with history, scientific when widened (packages/calculator).
pkgname=yggdrasil-calculator
pkgver=1.0.0
pkgrel=1
pkgdesc="Calculator: standard with history, scientific when widened"
arch=('x86_64')
provides=('labyrinth-calculator')
conflicts=('labyrinth-calculator')
replaces=('labyrinth-calculator')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../calculator"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-calculator" "$pkgdir/usr/bin/yggdrasil-calculator"
  install -Dm644 "$_src/yggdrasil-calculator.desktop" "$pkgdir/usr/share/applications/yggdrasil-calculator.desktop"
}
