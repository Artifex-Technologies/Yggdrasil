# Yggdrasil polkit authentication agent (the password box for administrator actions): prototype (Rust): built from packages/polkit in this repository.
pkgname=yggdrasil-polkit
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil polkit authentication agent (the password box for administrator actions): prototype"
arch=('x86_64')
provides=('labyrinth-polkit')
conflicts=('labyrinth-polkit')
replaces=('labyrinth-polkit')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'fontconfig' 'polkit')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../polkit"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-polkit" "$pkgdir/usr/bin/yggdrasil-polkit"

  # started at login by the desktop session
  install -Dm644 "$_src/yggdrasil-polkit-autostart.desktop" "$pkgdir/etc/xdg/autostart/yggdrasil-polkit.desktop"
}
