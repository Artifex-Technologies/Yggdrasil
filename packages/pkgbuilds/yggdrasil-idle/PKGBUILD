# Yggdrasil idle manager: watches how long you are away (observe-only unless configured) (Rust): built from packages/idle in this repository.
pkgname=yggdrasil-idle
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil idle manager: watches how long you are away (observe-only unless configured)"
arch=('x86_64')
provides=('labyrinth-idle')
conflicts=('labyrinth-idle')
replaces=('labyrinth-idle')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'wayland' 'systemd' 'libnotify')
optdepends=('openrazer-daemon: Razer keyboard and mouse lights go off while the screen is dimmed')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../idle"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-idle" "$pkgdir/usr/bin/yggdrasil-idle"
  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/autostart/yggdrasil-idle.desktop" <<'EOT'
[Desktop Entry]
Type=Application
Name=Yggdrasil idle watch
Comment=Logs how long you have been away (observe-only unless idle.conf says mode = act)
Exec=/usr/bin/yggdrasil-idle
NoDisplay=true
X-KDE-autostart-phase=2
EOT
  # the lid's suspend-then-hibernate (Settings > Power > When the lid is closed): asleep 25 minutes, then hibernate (closed 5 min,
  # then 30 min from closing); Settings writes /etc/systemd/sleep.conf.d/50-yggdrasil-lid.conf when the times change
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/sleep.conf.d/50-yggdrasil-lid.conf" <<'EOT'
[Sleep]
HibernateDelaySec=25min
EOT
}
