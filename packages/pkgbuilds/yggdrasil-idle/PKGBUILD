# Yggdrasil idle manager: watches how long you are away (observe-only unless configured) (Rust): built from packages/idle in this repository.
pkgname=yggdrasil-idle
pkgver=0.1.0
pkgrel=2
pkgdesc="Yggdrasil idle manager: watches how long you are away (observe-only unless configured)"
arch=('x86_64')
provides=('labyrinth-idle')
conflicts=('labyrinth-idle')
replaces=('labyrinth-idle')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'wayland' 'systemd' 'libnotify')
optdepends=('openrazer-daemon: Razer keyboard lights go off while the screen is dimmed')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../idle"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-idle" "$pkgdir/usr/bin/yggdrasil-idle"
  # lights hooks: run with lights-off / lights-on as the screen dims and you come back (keyboard-lights: Razer through openrazer,
  # laptop keyboard backlights through logind)
  install -Dm755 "$_src/idle.d/keyboard-lights" "$pkgdir/usr/lib/yggdrasil/idle.d/keyboard-lights"
  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/autostart/yggdrasil-idle.desktop" <<'EOT'
[Desktop Entry]
Type=Application
Name=Yggdrasil idle watch
Comment=Logs how long you have been away (observe-only unless idle.conf says mode = act)
Exec=/usr/bin/yggdrasil-idle
NoDisplay=true
X-KDE-autostart-phase=2
EOT
}
