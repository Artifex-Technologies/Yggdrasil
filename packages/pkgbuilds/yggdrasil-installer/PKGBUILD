# Yggdrasil's installer window (Rust, egui) and yggdrasil-install-system, the program that does the work from an archiso live
# medium: partitions, encryption, btrfs, copying the system, the account, GRUB. The OS names itself, its clean-up and finishing
# programs and its lists in an integration file of kind "installer" (docs/INSTALLER.md); it may name a program of its own instead.
# Built from packages/installer (the window) and packages/install-system (the install program, Rust; the Python script it
# replaced is kept in packages/installer/helpers/python for a rollback).
pkgname=yggdrasil-installer
pkgver=1.0.0
pkgrel=1
pkgdesc="Installs the operating system from its live medium: Yggdrasil's window and install program"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc' 'polkit' 'systemd'
         # the Network step: the adapters and networks (nmcli) and joining one (its D-Bus API)
         'networkmanager'
         # what yggdrasil-install-system runs
         'util-linux' 'cryptsetup' 'btrfs-progs' 'dosfstools' 'squashfs-tools' 'grub' 'efibootmgr')
optdepends=('e2fsprogs: ext4 for partitions chosen by hand'
            'xfsprogs: XFS for partitions chosen by hand'
            'flatpak: browsers from Flathub on the Browsers page')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../installer"
_sys="$startdir/../../install-system"
# the Network step's joining and reading (shared with Settings)
_netjoin="$startdir/../../netjoin"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src" "$_sys" "$_netjoin"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
  cd "$_sys"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
  # the install program on a made-up computer that runs nothing (every program it would run is answered in the test itself),
  # random plans, and the program itself only for what changes nothing (--check, --disks, a refused plan)
  cd "$_sys"
  cargo test --release --locked --target-dir "$srcdir/target"
  # joining a network against a made-up NetworkManager on a private socket pair, and nmcli's lists: nothing is joined
  cd "$_netjoin"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-installer" "$pkgdir/usr/bin/yggdrasil-installer"
  install -Dm755 "$srcdir/target/release/yggdrasil-install-system" "$pkgdir/usr/bin/yggdrasil-install-system"
}
