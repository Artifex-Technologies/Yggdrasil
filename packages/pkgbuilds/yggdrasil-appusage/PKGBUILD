# Maintainer: Yggdrasil
# Builds yggdrasil-appusage from packages/appusage/ in this repository: labyrinth-appusage, how long each app has been running
# (Settings > Apps, sort by usage). It replaces the Python script Labyrinth OS's image had at /usr/local/bin/labyrinth-appusage,
# with the same user service (labyrinth-appusage.service) and the same file. Build from this directory with `makepkg -s`.
pkgname=yggdrasil-appusage
pkgver=1.0.0
pkgrel=1
pkgdesc="How long each app has been running, for Settings > Apps (sort by usage)"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
provides=('labyrinth-appusage')
options=('!lto')

_src="$startdir/../../appusage"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  # the counting and the file on scratch folders; the live test (a made-up app's scope on the user's own systemd) skips itself
  # where there is no user manager
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/labyrinth-appusage" "$pkgdir/usr/bin/labyrinth-appusage"
  # on for every account: the installer enables it globally (systemctl --global enable labyrinth-appusage)
  install -Dm644 "$_src/systemd/labyrinth-appusage.service" "$pkgdir/usr/lib/systemd/user/labyrinth-appusage.service"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
