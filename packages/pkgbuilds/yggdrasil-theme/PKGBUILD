# Yggdrasil's look for the programs it does not write (Qt, KDE and GTK programs) and its mouse cursors: packages/theme.
# It replaces the WhiteSur KDE, GTK and cursor themes: a colour scheme (used with Qt's own Fusion style), GTK colours on GTK's own Adwaita,
# and cursors drawn by ygg-cursors. Nothing is downloaded and no other theme package is needed. ygg-theme and ygg-cursors are
# Rust (packages/theme/src; the Python scripts they replaced are kept in packages/theme/python for a rollback). ygg-cursors
# draws the cursors once here at build time, every pixel as the Python script drew it with Pillow (the help cursor's "?" with
# FreeType, laid out by libraqm, in the font fc-match names; Pillow's own default font when there is none).
pkgname=yggdrasil-theme
pkgver=0.1.0
pkgrel=5
pkgdesc="Yggdrasil's colour scheme, GTK colours and mouse cursors (replaces the WhiteSur themes)"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
# MIT-CMU: the drawing translated from Pillow; CC0-1.0: the Aileron subset Pillow carries as its default font
license=('MPL-2.0' 'MIT-CMU' 'CC0-1.0')
depends=('glibc' 'gcc-libs')
# gtk4: GTK 4's own theme is read from it (at build time) to make Yggdrasil's; fontconfig, freetype2 and libraqm: the help
# cursor's "?" (found with fc-match, opened at run time), as Pillow drew it
makedepends=('cargo' 'gtk4' 'fontconfig' 'freetype2' 'libraqm')
optdepends=('gtk3: GTK 3 programs use the Yggdrasil GTK theme'
            'freetype2: ygg-cursors, to draw the help cursor again (the package has the cursors drawn)'
            'libraqm: ygg-cursors lays the help cursor out with it, as the package did')
provides=('labyrinth-cursors')
options=('!lto')

_src="$startdir/../../theme"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
  "$srcdir/target/release/ygg-cursors" "$srcdir/cursors"
}

check() {
  cd "$_src"
  # the colours, ini files and a scratch home's apply and cursor, and the cursors against Pillow's own (every file's bytes):
  # nothing of the builder's own is touched
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/ygg-theme" "$pkgdir/usr/bin/ygg-theme"
  install -Dm755 "$srcdir/target/release/ygg-cursors" "$pkgdir/usr/bin/ygg-cursors"
  install -Dm644 "$_src/src/cursors/NOTICE-Pillow" "$pkgdir/usr/share/licenses/$pkgname/NOTICE-Pillow"
  # the cursors (an X cursor theme, which Wayland programs use as well)
  install -d "$pkgdir/usr/share/icons"
  cp -a "$srcdir/cursors" "$pkgdir/usr/share/icons/Yggdrasil"
  # the GTK 3 and GTK 4 themes: GTK's own with Yggdrasil's colours and surfaces (libadwaita programs read the colours in the user's stylesheet that ygg-theme writes)
  install -d "$pkgdir/usr/share/themes/Yggdrasil/gtk-3.0"
  "$srcdir/target/release/ygg-theme" gtk3-theme light > "$pkgdir/usr/share/themes/Yggdrasil/gtk-3.0/gtk.css"
  "$srcdir/target/release/ygg-theme" gtk3-theme dark  > "$pkgdir/usr/share/themes/Yggdrasil/gtk-3.0/gtk-dark.css"
  install -d "$pkgdir/usr/share/themes/Yggdrasil/gtk-4.0"
  "$srcdir/target/release/ygg-theme" gtk4-theme light > "$pkgdir/usr/share/themes/Yggdrasil/gtk-4.0/gtk.css"
  "$srcdir/target/release/ygg-theme" gtk4-theme dark  > "$pkgdir/usr/share/themes/Yggdrasil/gtk-4.0/gtk-dark.css"
  # the same dark, as a theme of its own: programs that load a theme by name and ignore the dark flag (Chromium's menus) get dark
  for v in 3 4; do
    install -d "$pkgdir/usr/share/themes/Yggdrasil-dark/gtk-$v.0"
    cp "$pkgdir/usr/share/themes/Yggdrasil/gtk-$v.0/gtk-dark.css" "$pkgdir/usr/share/themes/Yggdrasil-dark/gtk-$v.0/gtk.css"
    cp "$pkgdir/usr/share/themes/Yggdrasil/gtk-$v.0/gtk-dark.css" "$pkgdir/usr/share/themes/Yggdrasil-dark/gtk-$v.0/gtk-dark.css"
  done
  printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Yggdrasil dark\nComment=Yggdrasil colours on GTK'"'"'s Adwaita, dark\n\n[X-GNOME-Metatheme]\nGtkTheme=Yggdrasil-dark\nIconTheme=Liki\nCursorTheme=Yggdrasil\n' > "$pkgdir/usr/share/themes/Yggdrasil-dark/index.theme"
  printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Yggdrasil\nComment=Yggdrasil colours on GTK'"'"'s Adwaita\n\n[X-GNOME-Metatheme]\nGtkTheme=Yggdrasil\nIconTheme=Liki\nCursorTheme=Yggdrasil\n' > "$pkgdir/usr/share/themes/Yggdrasil/index.theme"
  # the pointer for programs started at login
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/environment.d/50-yggdrasil-cursor.conf" <<<$'XCURSOR_THEME=Yggdrasil\nXCURSOR_SIZE=24'
}
