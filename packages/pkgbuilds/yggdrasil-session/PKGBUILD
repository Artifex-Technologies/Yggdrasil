# Yggdrasil's own desktop session: Hyprland with Yggdrasil's config (built from packages/session in this repository), and the
# session's window keys yggdrasil-snap and yggdrasil-close and its careful log-out yggdrasil-logout (Rust, from packages/wm: they
# work on Yggdrasil's own compositor too). The magnifier, the screen reader switch, the Hyprland plugin loader and log keeper are
# Rust too (packages/session/src, shell scripts until 2026-11-12; the loader needed Python, the package does not any more).
pkgname=yggdrasil-session
pkgver=1.0.0
pkgrel=1
pkgdesc="Yggdrasil's own desktop session, on Hyprland"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'hyprland' 'xdg-desktop-portal-hyprland' 'yggdrasil-panel' 'yggdrasil-idle' 'yggdrasil-lock' 'yggdrasil-polkit' 'yggdrasil-portal' 'yggdrasil-xmove'
         'grim' 'slurp' 'wl-clipboard' 'libnotify' 'xdg-user-dirs'
         'gcc' 'pkgconf' 'zstd')  # the Hyprland plugin is built for the installed Hyprland at login (yggdrasil-hypr-plugin)
optdepends=('ghostty: the terminal on Super+Return' 'btop: running programs on Ctrl+Shift+Esc')
makedepends=('cargo')
options=('!lto')

_src="$startdir/../../session"
_wm="$startdir/../../wm"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch the folders above, the crates they use and this recipe (scripts/package-version.sh, Labyrinth_OS docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src" "$_wm"

build() {
  cd "$_wm"
  cargo build --release --locked --target-dir "$srcdir/target"
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_wm"
  cargo test --release --locked --target-dir "$srcdir/target"
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$_src/bin/yggdrasil-session" "$pkgdir/usr/bin/yggdrasil-session"
  install -Dm755 "$srcdir/target/release/yggdrasil-snap" "$pkgdir/usr/bin/yggdrasil-snap"
  install -Dm755 "$srcdir/target/release/yggdrasil-close" "$pkgdir/usr/bin/yggdrasil-close"
  install -Dm755 "$srcdir/target/release/yggdrasil-logout" "$pkgdir/usr/bin/yggdrasil-logout"
  install -Dm755 "$srcdir/target/release/yggdrasil-zoom" "$pkgdir/usr/bin/yggdrasil-zoom"
  install -Dm755 "$srcdir/target/release/yggdrasil-screen-reader" "$pkgdir/usr/bin/yggdrasil-screen-reader"
  install -Dm755 "$srcdir/target/release/yggdrasil-hypr-plugin" "$pkgdir/usr/bin/yggdrasil-hypr-plugin"
  install -Dm755 "$srcdir/target/release/yggdrasil-hypr-logkeep" "$pkgdir/usr/bin/yggdrasil-hypr-logkeep"
  install -Dm644 "$_src/hyprland/plugin/minimize.cpp" "$pkgdir/usr/share/yggdrasil/hyprland/plugin/minimize.cpp"
  install -Dm644 "$_src/hyprland/yggdrasil.lua" "$pkgdir/usr/share/yggdrasil/hyprland/yggdrasil.lua"
  install -Dm644 "$_src/hyprland/keep-clear.lua" "$pkgdir/usr/share/yggdrasil/hyprland/keep-clear.lua"
  # the person at the screen may read their mice and touchpads (the end of a window drag, for window zones); never keyboards
  install -Dm644 "$_src/udev/71-yggdrasil-pointer.rules" "$pkgdir/usr/lib/udev/rules.d/71-yggdrasil-pointer.rules"
  # the login screen lists it as "Yggdrasil"
  install -Dm644 "$_src/yggdrasil.desktop" "$pkgdir/usr/share/wayland-sessions/yggdrasil.desktop"
  # the session target: starting it starts the autostart folder (the panel and the rest)
  install -Dm644 "$_src/systemd/yggdrasil-session.target" "$pkgdir/usr/lib/systemd/user/yggdrasil-session.target"
}
