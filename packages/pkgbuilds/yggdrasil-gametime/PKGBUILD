# Maintainer: Yggdrasil
# Builds yggdrasil-gametime from packages/gametime/ in this repository. Build from this directory with `makepkg -s`.
pkgname=yggdrasil-gametime
pkgver=0.1.0
pkgrel=1
install=yggdrasil-gametime.install
pkgdesc="Yggdrasil's game time: background updates and chores wait while a game runs and catch up afterwards; security keeps running"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Yggdrasil"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc' 'systemd')
optdepends=('clamav: its signature updates move from the freshclam daemon to a timer that waits for games')
makedepends=('cargo')
backup=('etc/yggdrasil/gametime.conf')
options=('!lto')

_src="$startdir/../../gametime"

# The chores that wait while a game runs (docs/GAME_TIME.md says why each one). A drop-in for a unit that is not installed
# does nothing. Never here, because they protect the computer during a game: the leak watch, the downloads virus scan,
# heimdalld, Heimdall's LAN scan, labyrinth-sarina-held, snapper-timeline; sarina-night and labyrinth-sarina-reflect wait
# for games by themselves.
_wait_system=(
  clamav-freshclam-once.service      # virus definitions (the timer below replaces the freshclam daemon)
  heimdall-intel-update.service      # IP databases, threat lists, the security tracker
  heimdall-dns-blocklist.service     # the DNS block list
  heimdall-inventory.service         # the daily inventory of programs outside the packages
  fstrim.service                     # weekly SSD trim
  archlinux-keyring-wkd-sync.service # weekly refresh of the Arch packagers' keys
  snapper-cleanup.service            # removing old restore points
)
_wait_user=(
  yggdrasil-weather-record.service   # hourly forecast recording
  yggdrasil-weather-nowcast.service  # the rain warning, every 10 minutes
  labyrinth-publish.service          # building and publishing Labyrinth's packages
  labyrinth-sarina-checkup.service   # Sarina's daily check-up
)

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-gametime" "$pkgdir/usr/bin/yggdrasil-gametime"
  local u m
  for u in "${_wait_system[@]}"; do
    install -Dm644 "$_src/systemd/no-game.conf" "$pkgdir/usr/lib/systemd/system/$u.d/yggdrasil-gametime.conf"
  done
  for u in "${_wait_user[@]}"; do
    install -Dm644 "$_src/systemd/no-game.conf" "$pkgdir/usr/lib/systemd/user/$u.d/yggdrasil-gametime.conf"
  done
  # ClamAV's own once-timer, every 2 hours (the install script switches to it from the daemon)
  install -Dm644 "$_src/systemd/clamav-freshclam-once.timer.conf" \
    "$pkgdir/usr/lib/systemd/system/clamav-freshclam-once.timer.d/yggdrasil-gametime.conf"
  # the catch-up: every 5 minutes in the system manager and in every user's, a single stat when nothing waits
  for m in system user; do
    install -Dm644 "$_src/systemd/$m/yggdrasil-gametime-catch-up.service" "$pkgdir/usr/lib/systemd/$m/yggdrasil-gametime-catch-up.service"
    install -Dm644 "$_src/systemd/$m/yggdrasil-gametime-catch-up.timer" "$pkgdir/usr/lib/systemd/$m/yggdrasil-gametime-catch-up.timer"
    install -dm755 "$pkgdir/usr/lib/systemd/$m/timers.target.wants"
    ln -s ../yggdrasil-gametime-catch-up.timer "$pkgdir/usr/lib/systemd/$m/timers.target.wants/yggdrasil-gametime-catch-up.timer"
  done
  install -Dm644 "$_src/gametime.conf" "$pkgdir/etc/yggdrasil/gametime.conf"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
