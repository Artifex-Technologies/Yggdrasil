#!/usr/bin/env python3
"""labyrinth-appusage: how long each app has been running, for Settings > Apps ("sort by usage").

Every 30 seconds it looks at the running systemd scopes of this user (apps started by labyrinth-launch, by other launchers, by Flatpak),
works out which desktop entry each belongs to, and adds the time to ~/.local/share/labyrinth/app-usage.json
(`seconds`, next to the launch count labyrinth-launch writes). Only app names and seconds are kept; nothing leaves the machine.

  labyrinth-appusage            run forever (the user service labyrinth-appusage.service does)
  labyrinth-appusage --once     one sample, then exit (for tests)
"""
import json
import os
import re
import subprocess
import sys
import time

INTERVAL = 30


def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")


def desktop_ids():
    dirs = [os.path.join(data_home(), "applications")]
    dirs += [os.path.join(d, "applications") for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    dirs += [os.path.join(data_home(), "flatpak", "exports", "share", "applications"), "/var/lib/flatpak/exports/share/applications"]
    ids = set()
    for d in dirs:
        try:
            ids |= {f[:-8] for f in os.listdir(d) if f.endswith(".desktop")}
        except OSError:
            pass
    return ids


def sanitize(app_id):
    return re.sub(r"[^A-Za-z0-9_]", "_", app_id)


def match_unit(unit, ids):
    """The desktop id a scope belongs to, or None. Handles lapp_<id>_N.scope (ours), app-<id>-PID.scope and app-<id>@HASH.scope
    (KDE, with \\x2d for a dash), and app-flatpak-<id>-N.scope."""
    unit = unit.replace("\\x2d", "-")
    m = re.fullmatch(r"lapp_(.+)_(\d+)\.scope", unit)
    if m:
        san = m.group(1)
        for i in ids:
            if sanitize(i) == san:
                return i
        return None
    m = re.fullmatch(r"app-(?:flatpak-)?(.+?)(?:-\d+|@[0-9a-f]+)\.scope", unit)
    if m and m.group(1) in ids:
        return m.group(1)
    return None


def running_scopes():
    try:
        out = subprocess.run(["systemctl", "--user", "list-units", "--type=scope", "--state=running", "--no-legend", "--plain", "--no-pager"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [l.split()[0] for l in out.splitlines() if l.split()]


def sample(seconds, ids=None, units=None, path=None):
    """Add `seconds` to every app that is running now (once per app, however many windows it has)."""
    path = path or os.path.join(data_home(), "labyrinth", "app-usage.json")
    ids = ids if ids is not None else desktop_ids()
    units = units if units is not None else running_scopes()
    apps = {a for a in (match_unit(u, ids) for u in units) if a}
    if not apps:
        return set()
    try:
        with open(path, encoding="utf-8") as f:
            usage = json.load(f)
    except (OSError, ValueError):
        usage = {}
    for a in apps:
        e = usage.get(a) or {}
        e["seconds"] = int(e.get("seconds", 0)) + int(seconds)
        usage[a] = e
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(usage, f)
    os.replace(tmp, path)
    return apps


def main(argv):
    if "--once" in argv:
        sample(INTERVAL)
        return 0
    ids, refreshed = desktop_ids(), time.time()
    last = time.time()
    while True:
        time.sleep(INTERVAL)
        now = time.time()
        if now - refreshed > 600:
            ids, refreshed = desktop_ids(), now
        sample(min(now - last, 120), ids)
        last = now


if __name__ == "__main__":
    sys.exit(main(sys.argv))
