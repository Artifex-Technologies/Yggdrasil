#! /bin/sh
# grub-mkconfig fragment for the graphics-card unlock (gpuunlock, Settings > Power > Graphics card).
#
# Prints one menu entry only while an attempt is armed: `gpuunlock arm` writes the loader.conf below and picks the entry for the
# next start only; `gpuunlock verify` removes the file afterwards. Without the file it prints nothing, so on every other computer,
# and here the rest of the time, grub-mkconfig's output is unchanged. It never fails, so it can never stop a kernel update from
# writing the boot menu.
conf=${YGGDRASIL_GPUUNLOCK_CONF:-/var/lib/yggdrasil/gpu-unlock/loader.conf}
[ -r "$conf" ] || exit 0

ESP_UUID= LOADER= BDF= BAR0=
while IFS='=' read -r key value; do
  case $key in
    ESP_UUID) ESP_UUID=$value ;;
    LOADER) LOADER=$value ;;
    BDF) BDF=$value ;;
    BAR0) BAR0=$value ;;
  esac
done < "$conf"

# every value is checked against its exact shape before it goes into grub.cfg
ok() { printf '%s' "$2" | grep -Eqx "$1"; }
ok '[0-9A-Fa-f-]{4,36}' "$ESP_UUID" || exit 0
ok '[A-Za-z0-9_.-]+\.efi' "$LOADER" || exit 0
ok '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]' "$BDF" || exit 0
ok '0x[0-9a-f]{8,16}' "$BAR0" || exit 0

echo "Adding the graphics-card unlock entry (one try): $LOADER for $BDF" >&2
cat <<GRUB
menuentry 'Graphics card unlock (one try, then a normal start)' --class efi --id yggdrasil-gpu-unlock {
	insmod part_gpt
	insmod fat
	search --no-floppy --fs-uuid --set=root $ESP_UUID
	chainloader /EFI/yggdrasil/$LOADER bdf=$BDF bar0=$BAR0
}
GRUB
exit 0
