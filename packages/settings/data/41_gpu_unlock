#! /bin/sh
# grub-mkconfig fragment for the graphics card unlock (gpuunlock, Settings > Power > Graphics card).
#
# Prints the one-try entry only while an attempt is armed: `gpuunlock arm` writes entry.cfg, a copy of the menu's first entry
# with turing_unlock.targets= added for this card, and `gpuunlock verify` or `disarm` removes it. `gpuunlock grub-entry`
# checks that file has the shape of exactly one entry of ours (our id, one kernel line ending in the option for one PCI
# address, nothing that opens another entry, a plain file ending in a newline) and prints it whole, or prints nothing. The
# entry is never the default: I pick it by hand at a restart.
#
# This stays a few lines of sh, not the program itself: grub-mkconfig runs with `set -e`, so a fragment that fails stops a
# kernel update from writing the boot menu. Whatever happens to the program (missing, refused, stopped), this exits 0, and the
# program writes its output in one piece only once it has checked it.
helper=/usr/lib/yggdrasil/gpuunlock
[ -x "$helper" ] || exit 0
"$helper" grub-entry || true
exit 0
