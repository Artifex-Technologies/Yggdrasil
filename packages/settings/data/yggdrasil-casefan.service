[Unit]
Description=Case fans and pump on the Corsair Commander Pro, following the processor and graphics card temperatures (Settings > Power)
After=nvidia-persistenced.service systemd-modules-load.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
ExecStart=/usr/lib/yggdrasil/casefan run
# a clean stop: fans at a moderate speed, the pump full; a crash or failure (SERVICE_RESULT is not "success"): everything full
ExecStopPost=/usr/lib/yggdrasil/casefan reset
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
