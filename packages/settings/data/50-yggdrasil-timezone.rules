// Settings > Date & Time > "Set time zone automatically": the time zone may be changed without a password by an
// administrator (wheel) signed in at this computer, so the zone follows a laptop as it travels (yggdrasil-autozone.timer).
// Only the time zone: setting the clock itself, NTP and the rest of timedated still ask. Approved by the owner, 2026-11-13.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.timedate1.set-timezone" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
