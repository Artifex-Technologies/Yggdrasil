[Unit]
Description=Game controllers: battery in the top bar, saved light bar colours, connect and battery notifications
Documentation=file:///usr/share/doc/yggdrasil-controllers/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/yggdrasil-controllers daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
