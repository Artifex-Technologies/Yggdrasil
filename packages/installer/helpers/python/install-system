# ---------------------------------------------------------------- the operating system's settings
# configure() fills these from the integration file and os-release before anything is done; the values here are what a system
# that says nothing gets (and what the tests see).
OS_NAME = "Linux"
OS_ID = "linux"
SFS = "/run/archiso/bootmnt/linux/x86_64/airootfs.sfs"
