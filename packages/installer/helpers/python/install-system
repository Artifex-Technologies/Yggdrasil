          "/opt": ("btrfs", "ext4", "xfs"), "/boot/efi": ("vfat",), "swap": ("swap",)}
MIN_ROOT = 20 * 1024**3
MIN_ESP = 260 * 1024**2
MIB = 1024**2
SUBVOLUMES = [("@", ""), ("@home", "home"), ("@cache", "var/cache"), ("@log", "var/log")]
# the live medium's own account (every OS built on Yggdrasil names it so)
LIVE_USER = "live"
