[Unit]
Description=Yggdrasil spelling: keeps every app's word list in step with yours (Settings > Keyboard > Spelling and languages)
Documentation=file:///usr/share/doc/yggdrasil-spell/README.md

[Service]
ExecStart=/usr/bin/yggdrasil-spell watch
Restart=on-failure
RestartSec=10
# 75: the program was updated and exits to be started again (not a failure)
SuccessExitStatus=75
RestartForceExitStatus=75
# it reads the dictionaries and writes only word lists: the apps' (under ~/.config and ~/.mozilla), its own, and its offer to the
# shared list
ProtectSystem=strict
# a new account has neither folder yet, and a missing ReadWritePaths folder stops the start (a restart every 10 s, found in a
# VM test of the live ISO 2026-11-08): made first, outside the sandbox ("+")
ExecStartPre=+/usr/bin/mkdir -p %h/.config %h/.local/share/yggdrasil
ReadWritePaths=%h/.config -%h/.mozilla %h/.local/share/yggdrasil -/var/lib/yggdrasil/spell/offered
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LockPersonality=yes
MemoryMax=64M
Nice=10

[Install]
WantedBy=default.target
