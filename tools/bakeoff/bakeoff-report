#!/usr/bin/env python3
"""yggdrasil-bakeoff report [DIR]: compare the frame times MangoHud logged in each bake-off session (~/bakeoff/NAME-vrrX/*.csv).

Per session: average FPS, 1% and 0.1% lows (the FPS of the slowest 1% and 0.1% of frames), the frame-time spread, and stutters
(frames that took more than twice the usual time). Higher lows and fewer stutters feel smoother; the average matters least.
"""
import csv
import os
import re
import statistics
import sys


def frametimes(path):
    """Frame times in milliseconds from one MangoHud log (two lines of system details, then a header row, then one row per frame)."""
    with open(path, newline="", encoding="utf-8", errors="replace") as f:
        rows = list(csv.reader(f))
    for i, r in enumerate(rows):
        if "frametime" in r:
            col = r.index("frametime")
            out = []
            for row in rows[i + 1:]:
                try:
                    v = float(row[col])
                except (IndexError, ValueError):
                    continue
                if 0 < v < 1000:
                    out.append(v)
            return out
    return []


def summary(ft):
    s = sorted(ft)
    n = len(s)
    pct = lambda p: s[min(n - 1, int(n * p))]
    med = statistics.median(s)
    return {
        "frames": n,
        "avg_fps": 1000 * n / sum(s),
        "low1": 1000 / pct(0.99),
        "low01": 1000 / pct(0.999),
        "spread_ms": statistics.pstdev(s),
        "stutters": sum(1 for v in s if v > 2 * med),
    }


def game_of(filename):
    """MangoHud names a log after the game's program and the time: "TheForest_2026-10-23_18-01-02.csv" -> "TheForest"."""
    m = re.match(r"(.+?)_\d{4}-\d{2}-\d{2}", filename)
    return m.group(1) if m else filename.rsplit(".", 1)[0]


def main(root):
    if not os.path.isdir(root):
        print(f"nothing measured yet ({root} does not exist)")
        return 1
    # game -> [(session, runs, summary)]
    games = {}
    for d in sorted(os.listdir(root)):
        p = os.path.join(root, d)
        if not os.path.isdir(p):
            continue
        per_game = {}
        for f in sorted(os.listdir(p)):
            if f.endswith(".csv") and "summary" not in f:
                per_game.setdefault(game_of(f), []).append(os.path.join(p, f))
        for game, files in per_game.items():
            ft = [v for f in files for v in frametimes(f)]
            if len(ft) >= 100:
                games.setdefault(game, []).append((d, len(files), summary(ft)))
    if not games:
        print("no usable measurements yet (a run needs 20 s of play before logging starts, then 90 s)")
        return 1
    for game in sorted(games):
        print(f"\n{game}")
        print(f"  {'session':<20}{'runs':>5}{'avg FPS':>9}{'1% low':>9}{'0.1% low':>10}{'spread ms':>11}{'stutters':>10}")
        for name, runs, r in sorted(games[game], key=lambda x: -x[2]["low1"]):
            print(f"  {name:<20}{runs:>5}{r['avg_fps']:>9.1f}{r['low1']:>9.1f}{r['low01']:>10.1f}{r['spread_ms']:>11.2f}{r['stutters']:>10}")
    print("\nEach game on its own, sessions sorted by the 1% low (smoothness). Stutters: frames taking more than twice the usual time.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/bakeoff")))
